# Convierte cada shader de render/shaders/ en una cadena C++: mesh.vert -> kMeshVs,
# skin_shadow.vert -> kSkinShadowVs, common.glsl -> kCommonGlsl. Uso:
#   cmake -DOUT=<fichero.inc> -DSHADERS="a.vert;b.frag" -P embed_shaders.cmake
set(text "// Generado por cmake/embed_shaders.cmake: no editar.\n")
foreach(path ${SHADERS})
    get_filename_component(stem ${path} NAME_WE)
    get_filename_component(ext ${path} EXT)
    string(REPLACE "_" ";" words ${stem})
    set(name "k")
    foreach(w ${words})
        string(SUBSTRING ${w} 0 1 first)
        string(TOUPPER ${first} first)
        string(SUBSTRING ${w} 1 -1 rest)
        string(APPEND name "${first}${rest}")
    endforeach()
    if(ext STREQUAL ".vert")
        string(APPEND name "Vs")
    elseif(ext STREQUAL ".frag")
        string(APPEND name "Fs")
    else()
        string(APPEND name "Glsl")
    endif()
    file(READ ${path} src)
    string(APPEND text "const char* ${name} = R\"glsl(\n${src})glsl\";\n")
endforeach()
file(WRITE ${OUT} "${text}")
